# Twitter/X Account Credentials
TWITTER_USERNAME=your_username
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your_email@example.com

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5-mini
OPENAI_TEMPERATURE=0.7

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
HEADLESS_MODE=false

# Posting Schedule (minutes)
MIN_POST_INTERVAL=90
MAX_POST_INTERVAL=240
DAILY_POST_TARGET=8

# Engagement Settings
DAILY_REPLY_TARGET=20
MIN_REPLY_INTERVAL=5
MAX_REPLY_INTERVAL=30
MIN_TARGET_FOLLOWERS=500

# Content Settings
CONTENT_QUEUE_SIZE=20
CONTENT_GENERATION_BATCH=5
MEDIA_MAX_SIZE_MB=5
MIN_ENGAGEMENT_THRESHOLD=100

# Behavior Simulation
TYPING_SPEED_WPM=60
TYPING_VARIANCE=20
SESSION_DURATION_MIN=15
SESSION_DURATION_MAX=45
BREAK_DURATION_MIN=30
BREAK_DURATION_MAX=90

# Advanced Settings
MAX_RETRIES=3
TREND_FETCH_INTERVAL=60
REPLY_AI_TEMPERATURE=0.8
